---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ebin — Bengaluru's Responsible E-Waste Recycling">
  
  <!-- HERO SECTION (Bold, Netflix/Shopify High-Contrast Style) -->
  <section class="relative overflow-hidden bg-gradient-to-b from-charcoal-900 via-charcoal-900 to-charcoal-950 text-white pt-20 pb-24 lg:pt-32 lg:pb-36">
    <!-- Ambient Eco Glow Background -->
    <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-eco-600/15 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute -bottom-20 right-10 w-96 h-96 bg-eco-500/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto space-y-6">
        
        <!-- Local Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-charcoal-800/90 border border-charcoal-700 text-xs sm:text-sm font-semibold text-eco-400 shadow-sm backdrop-blur">
          <span class="w-2 h-2 rounded-full bg-eco-500 animate-pulse"></span>
          Exclusively Serving Bengaluru City
        </div>

        <!-- Primary Headline -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight leading-[1.08] text-white">
          Don’t let old tech sit in a drawer. <br class="hidden sm:inline" />
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-eco-400 via-eco-500 to-emerald-300">
            Recycle it with ebin.
          </span>
        </h1>

        <!-- Subheadline -->
        <p class="text-lg sm:text-xl text-charcoal-300 max-w-2xl mx-auto leading-relaxed">
          The cleanest, simplest way to dispose of retired electronics in Bengaluru. Doorstep pickups, fair indicative payout, and 100% certified zero-landfill recycling.
        </p>

        <!-- CTA Buttons Group -->
        <div class="pt-4 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/pickup/"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-black text-charcoal-950 bg-eco-500 hover:bg-eco-400 transition-all duration-200 transform hover:scale-105 shadow-lg shadow-eco-500/25"
          >
            Schedule Free Pickup
            <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>
          <a
            href="/price-guide/"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-4 rounded-full text-base font-bold text-white bg-charcoal-800 hover:bg-charcoal-700 border border-charcoal-700 transition-colors"
          >
            View Indicative Rates
          </a>
        </div>

        <!-- Key Trust Points -->
        <div class="pt-8 flex flex-wrap items-center justify-center gap-6 sm:gap-10 text-xs sm:text-sm text-charcoal-400">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-eco-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>KSPCB Authorized Recyclers</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-eco-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>100% Zero-Landfill Guarantee</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-eco-500" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
            <span>Doorstep Collection Across BBMP</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- QUICK STATS / BENGALURU CRISIS IMPACT (Clean, High-Whitespace) -->
  <section class="py-16 bg-white border-b border-charcoal-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-center">
        <div class="p-4">
          <p class="text-3xl sm:text-4xl font-black text-charcoal-900 tracking-tight">50,000+ T</p>
          <p class="text-xs sm:text-sm text-charcoal-500 font-medium mt-1">Bengaluru Annual E-Waste</p>
        </div>
        <div class="p-4">
          <p class="text-3xl sm:text-4xl font-black text-eco-600 tracking-tight">100%</p>
          <p class="text-xs sm:text-sm text-charcoal-500 font-medium mt-1">Zero-Landfill Processing</p>
        </div>
        <div class="p-4">
          <p class="text-3xl sm:text-4xl font-black text-charcoal-900 tracking-tight">198 Wards</p>
          <p class="text-xs sm:text-sm text-charcoal-500 font-medium mt-1">BBMP Citywide Pickup Scope</p>
        </div>
        <div class="p-4">
          <p class="text-3xl sm:text-4xl font-black text-eco-600 tracking-tight">24 Hours</p>
          <p class="text-xs sm:text-sm text-charcoal-500 font-medium mt-1">Fast Booking Confirmation</p>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS SECTION (The 4 Approved Stages) -->
  <section class="py-24 bg-charcoal-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="text-xs font-bold uppercase tracking-widest text-eco-600 bg-eco-100 px-3 py-1 rounded-full">
          Simple 4-Step Journey
        </span>
        <h2 class="text-3xl sm:text-4xl font-black text-charcoal-900 tracking-tight mt-3">
          How ebin works for you
        </h2>
        <p class="text-charcoal-600 text-base mt-3">
          No complicated apps or live GPS tracking gimmicks needed. We keep it personal, prompt, and transparent.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
        
        <!-- Stage 1 -->
        <div class="bg-white rounded-2xl p-7 shadow-sm border border-charcoal-100 hover:shadow-md transition-shadow relative">
          <div class="w-12 h-12 rounded-xl bg-eco-50 border border-eco-200 flex items-center justify-center text-eco-700 font-black text-xl mb-5">
            01
          </div>
          <h3 class="text-lg font-bold text-charcoal-900 mb-2">Request Received</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">
            Fill out our simple pickup form with your Bengaluru address, items, and preferred collection date.
          </p>
        </div>

        <!-- Stage 2 -->
        <div class="bg-white rounded-2xl p-7 shadow-sm border border-charcoal-100 hover:shadow-md transition-shadow relative">
          <div class="w-12 h-12 rounded-xl bg-eco-50 border border-eco-200 flex items-center justify-center text-eco-700 font-black text-xl mb-5">
            02
          </div>
          <h3 class="text-lg font-bold text-charcoal-900 mb-2">Confirmed by Call</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">
            Our local coordinator reviews your inventory and calls or WhatsApps you to lock in an exact arrival slot.
          </p>
        </div>

        <!-- Stage 3 -->
        <div class="bg-white rounded-2xl p-7 shadow-sm border border-charcoal-100 hover:shadow-md transition-shadow relative">
          <div class="w-12 h-12 rounded-xl bg-eco-50 border border-eco-200 flex items-center justify-center text-eco-700 font-black text-xl mb-5">
            03
          </div>
          <h3 class="text-lg font-bold text-charcoal-900 mb-2">Pickup Done</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">
            Our vetted executive collects your devices right at your doorstep, conducts a quick inspection, and hands you your receipt.
          </p>
        </div>

        <!-- Stage 4 -->
        <div class="bg-white rounded-2xl p-7 shadow-sm border border-charcoal-100 hover:shadow-md transition-shadow relative">
          <div class="w-12 h-12 rounded-xl bg-eco-50 border border-eco-200 flex items-center justify-center text-eco-700 font-black text-xl mb-5">
            04
          </div>
          <h3 class="text-lg font-bold text-charcoal-900 mb-2">Recycled Responsibly</h3>
          <p class="text-sm text-charcoal-600 leading-relaxed">
            Items go directly to authorized KSPCB dismantling centers. Precious metals are reclaimed; toxic chemicals are safely neutralized.
          </p>
        </div>

      </div>

      <div class="text-center mt-12">
        <a
          href="/how-it-works/"
          class="inline-flex items-center text-sm font-bold text-eco-700 hover:text-eco-800 transition-colors group"
        >
          Read full recycling process & data destruction protocol
          <svg class="ml-1.5 w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- ACCEPTED ITEMS SHOWCASE (Shopify / Netflix Grid Feel) -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 gap-4">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-eco-600 bg-eco-50 px-3 py-1 rounded-full">
            What We Accept
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-charcoal-900 tracking-tight mt-3">
            If it has a plug or a battery, we take it.
          </h2>
        </div>
        <a href="/price-guide/" class="text-sm font-bold text-eco-600 hover:text-eco-700">
          See Indicative Rates Guide &rarr;
        </a>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
        
        <!-- Category 1 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">Smartphones & Tablets</h3>
          <p class="text-xs text-charcoal-500">Android, iPhones, iPads, feature phones, cracked or working.</p>
        </div>

        <!-- Category 2 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">Laptops & Desktops</h3>
          <p class="text-xs text-charcoal-500">MacBooks, Windows PCs, servers, motherboards, hard drives.</p>
        </div>

        <!-- Category 3 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">TVs & Monitors</h3>
          <p class="text-xs text-charcoal-500">LED, LCD, old CRT monitors, desktop displays, projector units.</p>
        </div>

        <!-- Category 4 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">Batteries & Power</h3>
          <p class="text-xs text-charcoal-500">Laptop batteries, UPS lead-acid, power banks, Li-ion cells.</p>
        </div>

        <!-- Category 5 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">Printers & Peripherals</h3>
          <p class="text-xs text-charcoal-500">Keyboards, mice, inkjet/laser printers, scanners, routers.</p>
        </div>

        <!-- Category 6 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">Cables & Adapters</h3>
          <p class="text-xs text-charcoal-500">Copper cables, charger bricks, power cords, HDMI/VGA wires.</p>
        </div>

        <!-- Category 7 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">Small Appliances</h3>
          <p class="text-xs text-charcoal-500">Microwaves, coffee makers, electric kettles, vacuum cleaners.</p>
        </div>

        <!-- Category 8 -->
        <div class="border border-charcoal-100 rounded-2xl p-6 hover:border-eco-500 hover:shadow-lg transition-all group bg-white">
          <div class="w-12 h-12 rounded-xl bg-charcoal-50 flex items-center justify-center text-charcoal-700 group-hover:bg-eco-600 group-hover:text-white transition-colors mb-4">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-base font-bold text-charcoal-900 mb-1">Commercial / Office</h3>
          <p class="text-xs text-charcoal-500">Bulk office IT scrap, networking switches, server racks.</p>
        </div>

      </div>

    </div>
  </section>

  <!-- INDICATIVE RATES TEASER (Clearly Labeled "Indicative") -->
  <section class="py-20 bg-charcoal-900 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center mb-12">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-bold uppercase tracking-wider mb-4">
          <span>⚠️</span> Indicative Estimates Only
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
          Transparent rates. No haggling.
        </h2>
        <p class="text-charcoal-300 text-base mt-2">
          Devices are evaluated based on condition, model age, and components. Here are sample indicative payout ranges for common items.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        
        <div class="bg-charcoal-800/80 border border-charcoal-700 rounded-2xl p-6 text-center">
          <p class="text-xs uppercase tracking-wider text-charcoal-400 font-bold">Laptops</p>
          <p class="text-2xl font-black text-white mt-2">₹500 – ₹6,000*</p>
          <p class="text-xs text-eco-400 mt-1 font-semibold">Working / Scrap</p>
          <p class="text-[11px] text-charcoal-400 mt-3">Indicative estimate based on processor & battery condition.</p>
        </div>

        <div class="bg-charcoal-800/80 border border-charcoal-700 rounded-2xl p-6 text-center">
          <p class="text-xs uppercase tracking-wider text-charcoal-400 font-bold">Smartphones</p>
          <p class="text-2xl font-black text-white mt-2">₹200 – ₹4,500*</p>
          <p class="text-xs text-eco-400 mt-1 font-semibold">Touchscreen / Dead</p>
          <p class="text-[11px] text-charcoal-400 mt-3">Indicative estimate based on brand, screen state, and motherboard.</p>
        </div>

        <div class="bg-charcoal-800/80 border border-charcoal-700 rounded-2xl p-6 text-center">
          <p class="text-xs uppercase tracking-wider text-charcoal-400 font-bold">Monitors & LED TVs</p>
          <p class="text-2xl font-black text-white mt-2">₹300 – ₹2,500*</p>
          <p class="text-xs text-eco-400 mt-1 font-semibold">Display Units</p>
          <p class="text-[11px] text-charcoal-400 mt-3">Indicative estimate based on screen size and panel integrity.</p>
        </div>

      </div>

      <!-- Clarification on Recycling vs Resale -->
      <div class="mt-10 max-w-3xl mx-auto bg-charcoal-800/90 border border-charcoal-700 rounded-2xl p-6 text-left">
        <div class="flex items-start gap-3.5">
          <span class="text-2xl flex-shrink-0">♻️</span>
          <div class="space-y-1.5 text-xs text-charcoal-300">
            <h3 class="font-bold text-white text-sm">
              E-Waste Recycling vs. Second-Hand Reselling: Why Our Payouts Differ
            </h3>
            <p class="leading-relaxed">
              <strong>ebin is strictly an authorized electronic waste recovery service — we do not repair, refurbish, or resell gadgets to other consumers.</strong> Devices are scientifically dismantled for circular raw commodity recovery (gold, copper, aluminum) and safe hazardous neutralization under CPCB standards. Payouts reflect genuine material salvage value with guaranteed permanent data destruction, rather than second-hand retail margins.
            </p>
          </div>
        </div>
      </div>

      <div class="text-center mt-10">
        <a
          href="/price-guide/"
          class="inline-flex items-center justify-center px-6 py-3 rounded-full text-sm font-bold text-white bg-eco-600 hover:bg-eco-500 transition-colors shadow-md"
        >
          Check Full Indicative Price Guide &rarr;
        </a>
      </div>

    </div>
  </section>

  <!-- DROP-OFF LOCATIONS TEASER (Bengaluru Map Feature) -->
  <section class="py-24 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        
        <div class="space-y-6">
          <span class="text-xs font-bold uppercase tracking-widest text-eco-600 bg-eco-50 px-3 py-1 rounded-full">
            Neighborhood Hubs
          </span>
          <h2 class="text-3xl sm:text-4xl font-black text-charcoal-900 tracking-tight">
            Prefer dropping off your e-waste yourself?
          </h2>
          <p class="text-charcoal-600 text-base leading-relaxed">
            If you’re running errands or have just a single cable or old mobile, visit our verified community drop-off points across Koramangala, Indiranagar, BTM Layout, Whitefield, and Malleshwaram.
          </p>

          <div class="space-y-3 pt-2">
            <div class="flex items-center gap-3 text-sm text-charcoal-700">
              <span class="w-6 h-6 rounded-full bg-eco-100 text-eco-700 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Central collection bins at trusted electronics retailers</span>
            </div>
            <div class="flex items-center gap-3 text-sm text-charcoal-700">
              <span class="w-6 h-6 rounded-full bg-eco-100 text-eco-700 flex items-center justify-center text-xs font-bold">✓</span>
              <span>Open on weekends and evenings</span>
            </div>
