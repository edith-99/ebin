---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Indicative Price Guide"
  description="Indicative valuation rates for recycled electronics in Bengaluru. Phones, laptops, monitors, batteries, and appliances."
>
  
  <!-- Hero Section -->
  <section class="py-20 bg-charcoal-900 text-white relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl mx-auto space-y-4">
      <span class="text-xs font-bold uppercase tracking-widest text-eco-400 bg-charcoal-800 px-3.5 py-1.5 rounded-full border border-charcoal-700">
        Transparent Valuation
      </span>
      <h1 class="text-4xl sm:text-6xl font-black tracking-tight text-white">
        Indicative Price Guide
      </h1>
      <p class="text-base sm:text-lg text-charcoal-300 leading-relaxed">
        We believe in upfront, transparent pricing. Here are indicative compensation ranges for everyday electronics recycled through ebin in Bengaluru.
      </p>
    </div>
  </section>

  <!-- Educational Section: E-Waste Recycling vs Second-Hand Resale -->
  <section class="py-12 bg-white border-b border-charcoal-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-charcoal-50 rounded-3xl p-6 sm:p-10 border border-charcoal-200 shadow-sm space-y-6">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-charcoal-200 pb-4">
          <div class="flex items-center gap-3">
            <span class="w-10 h-10 rounded-2xl bg-eco-100 text-eco-700 flex items-center justify-center text-xl font-bold flex-shrink-0">
              ♻️
            </span>
            <div>
              <span class="text-xs font-bold uppercase tracking-wider text-eco-700">Fair Valuation Policy</span>
              <h2 class="text-xl sm:text-2xl font-black text-charcoal-900 tracking-tight">
                Why Our Rates Differ from Second-Hand Buyback Apps
              </h2>
            </div>
          </div>
          <span class="self-start sm:self-auto text-[11px] font-bold bg-charcoal-900 text-white px-3 py-1 rounded-full">
            Scrap & Material Recovery Only
          </span>
        </div>

        <p class="text-charcoal-700 text-sm leading-relaxed">
          Please note: <strong>ebin is exclusively a certified e-waste recycling service — we do not repair, refurbish, or resell old electronics to other consumers.</strong>
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs text-charcoal-600">
          <div class="bg-white p-5 rounded-2xl border border-charcoal-200 space-y-2">
            <strong class="text-charcoal-900 font-bold text-sm block">🔄 Material Reclamation vs. Consumer Resale</strong>
            <p class="leading-relaxed">
              Second-hand platforms (like Cashify or OLX) price devices based on consumer resale margin. In contrast, ebin prices devices strictly on <strong>raw commodity salvage value</strong> (reclaimed gold, copper, aluminum, and circular circuit board metals) under authorized CPCB recycling frameworks.
            </p>
          </div>

          <div class="bg-white p-5 rounded-2xl border border-charcoal-200 space-y-2">
            <strong class="text-charcoal-900 font-bold text-sm block">🛡️ Irrevocable Physical Data Destruction</strong>
            <p class="leading-relaxed">
              Because your devices are scientifically dismantled and shredded for raw materials rather than resold, your personal data and storage chips are permanently destroyed. Your retired tech will never be booted up or handed over to a stranger.
            </p>
          </div>
        </div>

        <div class="bg-eco-50/80 border border-eco-200 rounded-xl p-4 text-xs text-eco-900 flex items-start gap-2.5">
          <span class="text-base flex-shrink-0">💡</span>
          <p>
            <strong>The Bottom Line:</strong> If you have a working phone or laptop and are looking for second-hand market resale prices, commercial trade-in platforms will pay more. But if your electronics are obsolete, broken, or you want <strong>certified 100% zero-landfill disposal with guaranteed data destruction</strong>, ebin gives you fair scrap compensation with doorstep convenience.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- High-Visibility Indicative Disclaimer Banner -->
  <section class="bg-amber-50 border-b border-amber-200 py-6 px-4">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-4 text-center md:text-left">
      <div class="text-3xl flex-shrink-0">⚠️</div>
      <div class="space-y-1">
        <p class="text-sm font-black text-amber-950 uppercase tracking-wide">
          Notice: All Rates Below Are Strictly Indicative Scrap Estimates
        </p>
        <p class="text-xs text-amber-900 leading-relaxed">
          The rates below represent typical scrap material value based on weight, recoverable metals, and prevailing industrial salvage rates in Bengaluru. Payout is confirmed upon physical doorstep inspection.
        </p>
      </div>
      <div class="flex-shrink-0">
        <a href="/pickup/" class="inline-flex items-center px-4 py-2 rounded-lg bg-amber-900 text-white text-xs font-bold hover:bg-amber-800 transition-colors">
          Book Inspection
        </a>
      </div>
    </div>
  </section>

  <!-- Interactive Estimator Widget (100% Client-Side, No Backend Needed) -->
  <section class="py-12 bg-charcoal-50 border-b border-charcoal-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-charcoal-200">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 border-b border-charcoal-100 pb-5 mb-6">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-eco-600 bg-eco-50 px-2.5 py-1 rounded">Quick Estimator</span>
            <h2 class="text-xl font-black text-charcoal-900 mt-2">Estimate Your Indicative Total</h2>
          </div>
          <div class="text-right">
            <p class="text-xs text-charcoal-400 font-semibold">Estimated Payout Range</p>
            <p id="total-estimate" class="text-2xl sm:text-3xl font-black text-eco-600">₹0 – ₹0</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs">
          <div>
            <label class="block font-bold text-charcoal-700 mb-1">Old Laptops</label>
            <select id="calc-laptop" class="calc-input w-full p-2.5 rounded-lg border border-charcoal-200 bg-white">
              <option value="0">0 Laptops</option>
              <option value="1">1 Laptop (~₹800–₹3,000)</option>
              <option value="2">2 Laptops (~₹1,600–₹6,000)</option>
              <option value="3">3+ Laptops (~₹2,400–₹9,000)</option>
            </select>
          </div>

          <div>
            <label class="block font-bold text-charcoal-700 mb-1">Smartphones / Tablets</label>
            <select id="calc-phone" class="calc-input w-full p-2.5 rounded-lg border border-charcoal-200 bg-white">
              <option value="0">0 Phones</option>
              <option value="1">1 Phone (~₹300–₹1,500)</option>
              <option value="2">2 Phones (~₹600–₹3,000)</option>
              <option value="3">3+ Phones (~₹900–₹4,500)</option>
            </select>
          </div>

          <div>
            <label class="block font-bold text-charcoal-700 mb-1">TVs / Monitors</label>
            <select id="calc-tv" class="calc-input w-full p-2.5 rounded-lg border border-charcoal-200 bg-white">
              <option value="0">0 Displays</option>
              <option value="1">1 Screen (~₹400–₹1,800)</option>
              <option value="2">2 Screens (~₹800–₹3,600)</option>
            </select>
          </div>
        </div>

        <p class="text-[11px] text-charcoal-400 mt-4 text-center">
          * Instant estimation is for demonstration and guidance. Exact compensation is confirmed during doorstep evaluation.
        </p>
      </div>
    </div>
  </section>

  <!-- Detailed Fixed Indicative Rate Tables -->
  <section class="py-20 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Category 1: Computing & Laptops -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-charcoal-900 text-white flex items-center justify-center font-bold">
            💻
          </div>
          <div>
            <h3 class="text-2xl font-black text-charcoal-900 tracking-tight">Laptops & Computers</h3>
            <p class="text-xs text-charcoal-500">Indicative rates for notebooks, desktops, and components</p>
          </div>
        </div>

        <div class="overflow-x-auto border border-charcoal-200 rounded-2xl shadow-sm">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="bg-charcoal-50 border-b border-charcoal-200 text-xs uppercase tracking-wider text-charcoal-600 font-bold">
                <th class="p-4">Item Type</th>
                <th class="p-4">Working Condition</th>
                <th class="p-4">Non-Working / Scrap</th>
                <th class="p-4">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-charcoal-100 text-charcoal-800">
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Intel Core i5 / i7 / Apple Silicon Laptop</td>
                <td class="p-4 text-eco-700 font-bold">₹2,500 – ₹7,500*</td>
                <td class="p-4 text-charcoal-600">₹800 – ₹1,800*</td>
                <td class="p-4 text-xs text-charcoal-500">Motherboard & screen condition considered</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Intel Core i3 / Dual-Core / Older Laptop</td>
                <td class="p-4 text-eco-700 font-bold">₹1,000 – ₹2,500*</td>
                <td class="p-4 text-charcoal-600">₹400 – ₹800*</td>
                <td class="p-4 text-xs text-charcoal-500">Includes power brick</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Desktop CPU Tower (Complete unit)</td>
                <td class="p-4 text-eco-700 font-bold">₹800 – ₹2,500*</td>
                <td class="p-4 text-charcoal-600">₹400 – ₹800*</td>
                <td class="p-4 text-xs text-charcoal-500">SMPS, RAM & Motherboard intact</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Server Blades & Racks</td>
                <td class="p-4 text-eco-700 font-bold">Custom Quote</td>
                <td class="p-4 text-charcoal-600">₹150 – ₹350 / kg*</td>
                <td class="p-4 text-xs text-charcoal-500">Industrial scrap weight valuation</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Category 2: Smartphones & Personal Devices -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-charcoal-900 text-white flex items-center justify-center font-bold">
            📱
          </div>
          <div>
            <h3 class="text-2xl font-black text-charcoal-900 tracking-tight">Phones, Tablets & Wearables</h3>
            <p class="text-xs text-charcoal-500">Indicative rates for handheld communication gadgets</p>
          </div>
        </div>

        <div class="overflow-x-auto border border-charcoal-200 rounded-2xl shadow-sm">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="bg-charcoal-50 border-b border-charcoal-200 text-xs uppercase tracking-wider text-charcoal-600 font-bold">
                <th class="p-4">Item Type</th>
                <th class="p-4">Working Condition</th>
                <th class="p-4">Cracked Screen / Scrap</th>
                <th class="p-4">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-charcoal-100 text-charcoal-800">
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Flagship Smartphone (iPhone / Galaxy S)</td>
                <td class="p-4 text-eco-700 font-bold">₹2,000 – ₹7,000*</td>
                <td class="p-4 text-charcoal-600">₹500 – ₹1,200*</td>
                <td class="p-4 text-xs text-charcoal-500">iCloud / Samsung account unlocked</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Standard 4G/5G Android Smartphone</td>
                <td class="p-4 text-eco-700 font-bold">₹600 – ₹2,000*</td>
                <td class="p-4 text-charcoal-600">₹150 – ₹400*</td>
                <td class="p-4 text-xs text-charcoal-500">Redmi, Realme, OnePlus, Vivo, Oppo</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">iPads & Android Tablets</td>
                <td class="p-4 text-eco-700 font-bold">₹800 – ₹3,500*</td>
                <td class="p-4 text-charcoal-600">₹250 – ₹600*</td>
                <td class="p-4 text-xs text-charcoal-500">Display panel valuation</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Feature Keypad Phones</td>
                <td class="p-4 text-eco-700 font-bold">₹50 – ₹150*</td>
                <td class="p-4 text-charcoal-600">₹30 – ₹60*</td>
                <td class="p-4 text-xs text-charcoal-500">Recycled primarily for PCB copper/gold</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Category 3: Displays, TVs & Monitors -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-charcoal-900 text-white flex items-center justify-center font-bold">
            📺
          </div>
          <div>
            <h3 class="text-2xl font-black text-charcoal-900 tracking-tight">Televisions & Monitors</h3>
            <p class="text-xs text-charcoal-500">Indicative rates for flat panel and CRT displays</p>
          </div>
        </div>

        <div class="overflow-x-auto border border-charcoal-200 rounded-2xl shadow-sm">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="bg-charcoal-50 border-b border-charcoal-200 text-xs uppercase tracking-wider text-charcoal-600 font-bold">
                <th class="p-4">Item Type</th>
                <th class="p-4">Working Condition</th>
                <th class="p-4">Broken Panel / Dead</th>
                <th class="p-4">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-charcoal-100 text-charcoal-800">
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">LED / Smart TV (32" – 55")</td>
                <td class="p-4 text-eco-700 font-bold">₹800 – ₹3,000*</td>
                <td class="p-4 text-charcoal-600">₹200 – ₹500*</td>
                <td class="p-4 text-xs text-charcoal-500">Cracked glass panels have lower scrap value</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Computer Monitors (LED / LCD)</td>
                <td class="p-4 text-eco-700 font-bold">₹400 – ₹1,500*</td>
                <td class="p-4 text-charcoal-600">₹100 – ₹300*</td>
                <td class="p-4 text-xs text-charcoal-500">Includes power cable/stand</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Old CRT Tube TVs & Monitors</td>
                <td class="p-4 text-charcoal-600">Free Recycling</td>
                <td class="p-4 text-charcoal-600">Free Safe Disposal</td>
                <td class="p-4 text-xs text-charcoal-500">Contains high lead content in funnel glass; handled at zero cost</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Category 4: Power, Cables & Batteries -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <div class="w-10 h-10 rounded-xl bg-charcoal-900 text-white flex items-center justify-center font-bold">
            🔋
          </div>
          <div>
            <h3 class="text-2xl font-black text-charcoal-900 tracking-tight">Batteries, UPS & Cables</h3>
            <p class="text-xs text-charcoal-500">Weight-based and piece-rate indicative estimates</p>
          </div>
        </div>

        <div class="overflow-x-auto border border-charcoal-200 rounded-2xl shadow-sm">
          <table class="w-full text-left text-sm border-collapse">
            <thead>
              <tr class="bg-charcoal-50 border-b border-charcoal-200 text-xs uppercase tracking-wider text-charcoal-600 font-bold">
                <th class="p-4">Item Type</th>
                <th class="p-4">Indicative Rate</th>
                <th class="p-4">Unit Basis</th>
                <th class="p-4">Notes</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-charcoal-100 text-charcoal-800">
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Inverter / UPS Lead-Acid Battery</td>
                <td class="p-4 text-eco-700 font-bold">₹55 – ₹70 / kg*</td>
                <td class="p-4 text-charcoal-600">Per Kilogram</td>
                <td class="p-4 text-xs text-charcoal-500">High lead recovery value; weighed on-site</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Copper Wiring & Power Cords</td>
                <td class="p-4 text-eco-700 font-bold">₹140 – ₹240 / kg*</td>
                <td class="p-4 text-charcoal-600">Per Kilogram</td>
                <td class="p-4 text-xs text-charcoal-500">Based on copper insulation percentage</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Laptop Battery Packs (Lithium)</td>
                <td class="p-4 text-eco-700 font-bold">₹40 – ₹100*</td>
                <td class="p-4 text-charcoal-600">Per Unit</td>
                <td class="p-4 text-xs text-charcoal-500">Recycled for Cobalt and Lithium salts</td>
              </tr>
              <tr class="hover:bg-charcoal-50/50">
                <td class="p-4 font-bold">Power Banks & Cell Phone Batteries</td>
                <td class="p-4 text-eco-700 font-bold">₹20 – ₹60*</td>
                <td class="p-4 text-charcoal-600">Per Unit</td>
                <td class="p-4 text-xs text-charcoal-500">Safe discharge and neutral packaging</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>



  <!-- CTA Banner -->
  <section class="py-16 bg-charcoal-900 text-white text-center">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-4">
      <h2 class="text-3xl font-black">Ready to turn your e-waste into value?</h2>
      <p class="text-charcoal-400 text-sm">Schedule your doorstep collection today.</p>
      <div class="pt-3">
        <a
          href="/pickup/"
          class="inline-flex items-center justify-center px-8 py-3.5 rounded-full text-sm font-bold text-charcoal-900 bg-eco-500 hover:bg-eco-400 transition-colors shadow-lg"
        >
          Book Doorstep Pickup
        </a>
      </div>
    </div>
  </section>

</Layout>

<script>
  function updateEstimate() {
    const laptopVal = parseInt((document.getElementById('calc-laptop') as HTMLSelectElement)?.value || '0');
    const phoneVal = parseInt((document.getElementById('calc-phone') as HTMLSelectElement)?.value || '0');
    const tvVal = parseInt((document.getElementById('calc-tv') as HTMLSelectElement)?.value || '0');

    const min = (laptopVal * 800) + (phoneVal * 300) + (tvVal * 400);
    const max = (laptopVal * 3000) + (phoneVal * 1500) + (tvVal * 1800);

    const totalEl = document.getElementById('total-estimate');
    if (totalEl) {
      if (min === 0 && max === 0) {
        totalEl.textContent = '₹0 – ₹0';
      } else {
        totalEl.textContent = `₹${min.toLocaleString('en-IN')} – ₹${max.toLocaleString('en-IN')}`;
      }
    }
  }

  document.querySelectorAll('.calc-input').forEach((el) => {
    el.addEventListener('change', updateEstimate);
  });
</script>
